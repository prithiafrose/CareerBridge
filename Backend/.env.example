# Server port. Railway sets PORT automatically.
PORT=5001

# REQUIRED on production - use a long random string, e.g:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional - the AI chatbot uses this; when empty it falls back to built-in replies.
OPENAI_API_KEY=

# ---------- Local MySQL (used when Railway MySQL vars are NOT set) ----------
DB_HOST=localhost
DB_NAME=job_portal_db
DB_USER=root
DB_PASSWORD=

# ---------- Railway MySQL plugin (auto-provided, do not edit) ----------
# The Railway MySQL addon injects MYSQL_URL (or MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE) automatically. They override the
# DB_* values above. No action needed.